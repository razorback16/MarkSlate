{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "core:menu:default",
    "core:window:allow-set-title",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists"
  ]
}
